# Copy to .env and adjust. Never commit .env.

# Signing key for the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HGSFP_SECRET_KEY=change-me-before-deploying

# Public base URL — used to build participation links and QR codes.
HGSFP_BASE_URL=http://127.0.0.1:8000

# Set to true behind a TLS reverse proxy so the session cookie gets Secure.
HGSFP_COOKIE_SECURE=false

# SQLite database file.
HGSFP_DATABASE_PATH=data/hgsfp.db

# Sentence-transformer model directory for comment clustering.
HGSFP_MODEL_PATH=models/all-MiniLM-L6-v2

# --- Obergrenzen für Eingaben (Standardwerte, selten anzupassen) ---
# Maximaler Request-Body einer Abgabe in Bytes.
HGSFP_MAX_SUBMISSION_BYTES=262144
# Maximale Länge eines Freitextfeldes; längere Antworten werden gekürzt.
HGSFP_MAX_FREE_TEXT_CHARS=5000
# Maximale Größe einer hochgeladenen Ergebnisdatei in Bytes.
HGSFP_MAX_UPLOAD_BYTES=26214400
